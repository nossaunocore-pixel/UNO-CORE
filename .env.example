# Variáveis públicas do cliente (configuração Firebase)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# Supabase — a chave publishable é preferida; ANON é fallback legado
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_ANON_KEY=

# Segredos exclusivamente server-side — nunca prefixar com VITE_
SUPABASE_SERVICE_ROLE_KEY=
FIREBASE_SERVICE_ACCOUNT_JSON=
# Definir somente após confirmar o UID Firebase da conta fundadora
UNO_FOUNDER_UID=
GOOGLE_GENERATIVE_AI_API_KEY=
# Definir após aprovação do fundador: máximo global de respostas públicas/dia (fail-closed se vazio).
PUBLIC_CHAT_GLOBAL_DAILY_LIMIT=

# Sessões de visitante via Supabase Auth: habilitar Anonymous Sign-Ins no Dashboard.
# Antes de produção, configurar CAPTCHA/Turnstile e política de limpeza de usuários anônimos.
