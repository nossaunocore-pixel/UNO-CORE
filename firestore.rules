rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regras de Segurança do NÓS S.A. / UNO
    
    // Alertas holográficos: leitura aberta para moradores autenticados, escrita restrita a operadores e admin
    match /alertas/{alertId} {
      allow read: if true;
      allow create, update: if request.auth != null;
      allow delete: if request.auth != null && request.auth.token.role == 'admin';
    }
    
    // Módulos do Mapa: leitura pública, atualização restrita
    match /modulos/{moduleId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // Perfil do Usuário / Morador: leitura pelo próprio usuário ou admin
    match /usuarios/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Transações do Marketplace
    match /transacoes/{transationId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null;
    }
  }
}
