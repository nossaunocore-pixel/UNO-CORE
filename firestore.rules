rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // A identidade UNO é provisionada exclusivamente pelo backend Admin SDK.
    match /uno_identity_links/{firebaseUid} {
      allow read, write: if false;
    }

    // Perfil legado: leitura própria, sem escrita direta do cliente.
    match /usuarios/{firebaseUid} {
      allow read: if request.auth != null && request.auth.uid == firebaseUid;
      allow create, update, delete: if false;
    }

    // Negação por padrão para todas as demais coleções.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
